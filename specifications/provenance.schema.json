{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bastionvault.dev/sdk/provenance.schema.json",
  "title": "BastionVault specification provenance manifest",
  "description": "CNF-044/CNF-045: pins the upstream BastionVault ref specifications/ was derived from, and the git object id of every upstream source that feeds a specification document.",
  "type": "object",
  "required": ["$schema", "specificationVersion", "upstream", "sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specificationVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "upstream": {
      "type": "object",
      "required": ["repository", "ref", "release", "commit", "treeSha", "pinnedOn"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pinnedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type", "objectId", "sensitivity", "feeds"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": ["blob", "tree"]
          },
          "objectId": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sensitivity": {
            "enum": ["authoritative", "corroborating"]
          },
          "feeds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
