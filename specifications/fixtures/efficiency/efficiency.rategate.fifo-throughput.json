{
  "id": "efficiency.rategate.fifo-throughput",
  "title": "The token bucket lets Burst requests through at once and then serves the queue in arrival order at RatePerSecond",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": [
    "EFF-001",
    "EFF-002",
    "BAT-007"
  ],
  "level": "core",
  "sections": [
    "14"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 8,
        "Burst": 2
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "clock": {
    "delay": "virtual",
    "expectWaits": [
      "PT0.125S",
      "PT0.125S"
    ]
  },
  "operation": {
    "name": "Kv.ReadMany",
    "args": {
      "mount": "secret",
      "paths": [
        "app/a",
        "app/b",
        "app/c"
      ]
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v2/sys/batch",
        "body": {
          "operations": [
            {
              "operation": "read",
              "path": "secret/data/app/a"
            },
            {
              "operation": "read",
              "path": "secret/data/app/b"
            },
            {
              "operation": "read",
              "path": "secret/data/app/c"
            }
          ]
        }
      },
      "respond": {
        "status": 404,
        "body": {
          "errors": [
            "logical backend path not supported"
          ]
        }
      }
    },
    {
      "expectRequest": {
        "method": "GET",
        "url": "https://vault.example.com:8200/v1/secret/data/app/a"
      },
      "respond": {
        "status": 200,
        "body": {
          "data": {
            "data": {
              "k": "a"
            },
            "metadata": {
              "version": 1,
              "created_time": "2026-09-13T09:00:00Z",
              "deletion_time": "",
              "destroyed": false
            }
          }
        }
      }
    },
    {
      "expectRequest": {
        "method": "GET",
        "url": "https://vault.example.com:8200/v1/secret/data/app/b"
      },
      "respond": {
        "status": 200,
        "body": {
          "data": {
            "data": {
              "k": "b"
            },
            "metadata": {
              "version": 1,
              "created_time": "2026-09-13T09:00:00Z",
              "deletion_time": "",
              "destroyed": false
            }
          }
        }
      }
    },
    {
      "expectRequest": {
        "method": "GET",
        "url": "https://vault.example.com:8200/v1/secret/data/app/c"
      },
      "respond": {
        "status": 200,
        "body": {
          "data": {
            "data": {
              "k": "c"
            },
            "metadata": {
              "version": 1,
              "created_time": "2026-09-13T09:00:00Z",
              "deletion_time": "",
              "destroyed": false
            }
          }
        }
      }
    }
  ],
  "expect": {
    "result": {
      "app/a": {
        "Data": {
          "k": "a"
        }
      },
      "app/b": {
        "Data": {
          "k": "b"
        }
      },
      "app/c": {
        "Data": {
          "k": "c"
        }
      }
    }
  }
}
