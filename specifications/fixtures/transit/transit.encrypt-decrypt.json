{
  "id": "transit.encrypt-decrypt",
  "title": "Encrypt then Decrypt round-trips the plaintext through the bvault: ciphertext framing",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": [
    "TRS-003",
    "TRS-013"
  ],
  "level": "standard",
  "sections": [
    "08"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Transit.EncryptThenDecrypt",
    "args": {
      "mount": "transit",
      "name": "roundtrip-key",
      "plaintext": "aGVsbG8gd29ybGQ="
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/transit/encrypt/roundtrip-key",
        "body": {
          "plaintext": "aGVsbG8gd29ybGQ="
        }
      },
      "respond": {
        "status": 200,
        "body": {
          "data": {
            "ciphertext": "bvault:v1:c2VhbGVkLWJ5dGVz",
            "key_version": 1
          }
        }
      }
    },
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/transit/decrypt/roundtrip-key",
        "body": {
          "ciphertext": "bvault:v1:c2VhbGVkLWJ5dGVz"
        }
      },
      "respond": {
        "status": 200,
        "body": {
          "data": {
            "plaintext": "aGVsbG8gd29ybGQ="
          }
        }
      }
    }
  ],
  "expect": {
    "result": {
      "Ciphertext": "bvault:v1:c2VhbGVkLWJ5dGVz",
      "KeyVersion": 1,
      "Plaintext": "$redacted",
      "RoundTrip": true
    }
  }
}
