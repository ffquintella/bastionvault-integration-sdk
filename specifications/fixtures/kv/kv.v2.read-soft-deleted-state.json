{
  "id": "kv.v2.read-soft-deleted-state",
  "title": "Soft-deleted version reads as 200 with null data and SoftDeleted state",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": [
    "KV2-004"
  ],
  "level": "core",
  "sections": [
    "07"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Kv.V2.ReadSecret",
    "args": {
      "mount": "secret",
      "path": "app/db"
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "GET",
        "url": "https://vault.example.com:8200/v1/secret/data/app/db"
      },
      "respond": {
        "status": 200,
        "body": {
          "renewable": false,
          "lease_id": "",
          "lease_duration": 0,
          "auth": null,
          "data": {
            "data": null,
            "metadata": {
              "version": 2,
              "created_time": "2026-09-13T09:00:00Z",
              "deletion_time": "2026-09-13T11:00:00Z",
              "destroyed": false
            }
          }
        }
      }
    }
  ],
  "expect": {
    "result": {
      "State": "SoftDeleted",
      "Data": "$absent",
      "Metadata": {
        "Version": 2,
        "DeletionTime": "2026-09-13T11:00:00Z",
        "Destroyed": false
      }
    }
  }
}
