{
  "id": "kv.v2.write-cas-ok",
  "title": "Write with CAS sends options.cas and returns version metadata",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": [
    "KV2-003"
  ],
  "level": "core",
  "sections": [
    "07"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Kv.V2.WriteSecret",
    "args": {
      "mount": "secret",
      "path": "app/db",
      "data": {
        "password": "p3"
      },
      "options": {
        "Cas": 2
      }
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/secret/data/app/db",
        "body": {
          "data": {
            "password": "p3"
          },
          "options": {
            "cas": 2
          }
        }
      },
      "respond": {
        "status": 200,
        "body": {
          "renewable": false,
          "lease_id": "",
          "lease_duration": 0,
          "auth": null,
          "data": {
            "version": 3,
            "created_time": "2026-09-13T12:00:00Z",
            "deletion_time": "",
            "destroyed": false
          }
        }
      }
    }
  ],
  "expect": {
    "result": {
      "Version": 3,
      "Destroyed": false,
      "DeletionTime": "$absent"
    }
  }
}
