  "sections": [
    "13"
  ],
  "client": {
    "address": "vault.corp.example",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "clusterDiscovery": true,
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      }
    }
  },
  "resolver": {
    "_bvault._tcp.vault.corp.example": [
      { "priority": 10, "weight": 50, "port": 8200, "target": "n1.corp.example" },
      { "priority": 10, "weight": 50, "port": 8200, "target": "n2.corp.example" },
      { "priority": 10, "weight": 50, "port": 8200, "target": "n3.corp.example" },
      { "priority": 10, "weight": 50, "port": 8200, "target": "n4.corp.example" },
      { "priority": 10, "weight": 50, "port": 8200, "target": "n5.corp.example" },
      { "priority": 10, "weight": 50, "port": 8200, "target": "n6.corp.example" }
    ]
  },
  "operation": {
    "name": "Client.Discover"
  },
  "exchanges": [
