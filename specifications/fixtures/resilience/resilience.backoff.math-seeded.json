  "requirements": [
    "RES-003"
  ],
  "level": "standard",
  "sections": [
    "13"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 3,
        "InitialBackoff": "PT0.1S",
        "MaxBackoff": "PT0.15S",
        "BackoffMultiplier": 2,
        "Jitter": 0.2
      },
      "__jitter": {
        "values": [
          0.0,
          1.0
        ]
      }
    }
  },
  "clock": {
