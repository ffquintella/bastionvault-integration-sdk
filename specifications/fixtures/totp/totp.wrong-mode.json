{
  "id": "totp.wrong-mode",
  "title": "GET code on a provider-mode key maps to WrongModeForOperation",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": [
    "TOT-003"
  ],
  "level": "standard",
  "sections": [
    "11"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Totp.GenerateCode",
    "args": {
      "mount": "totp",
      "name": "alice"
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "GET",
        "url": "https://vault.example.com:8200/v1/totp/code/alice"
      },
      "respond": {
        "status": 500,
        "body": {
          "error": "this key is provider-mode; POST a `code` to validate, not GET"
        }
      }
    }
  ],
  "expect": {
    "error": {
      "code": "BV-TOTP-002",
      "statusCode": 500,
      "retryable": false
    }
  }
}
