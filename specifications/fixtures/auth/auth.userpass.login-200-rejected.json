  "level": "core",
  "sections": [
    "05"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": null,
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Auth.Userpass.Login",
    "args": {
      "username": "alice",
      "password": "password-fixture",
      "mount": "userpass"
    }
  },
  "exchanges": [
