{
  "id": "auth.userpass.totp-required",
  "title": "A 200 login rejection asking for a TOTP code maps to BV-AUTH-007",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": ["AUT-010", "AUT-011"],
  "level": "core",
  "sections": ["05"],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": null,
    "namespace": "",
    "apiPrefix": "v1",
    "settings": { "RateGate": { "RatePerSecond": 0 }, "RetryPolicy": { "MaxAttempts": 1 } }
  },
  "operation": {
    "name": "Auth.Userpass.Login",
    "args": { "username": "alice", "password": "password-fixture", "mount": "userpass" }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/auth/userpass/login/alice",
        "absentHeaders": ["X-BastionVault-Token"],
        "body": { "password": "password-fixture" }
      },
      "respond": {
        "status": 200,
        "body": {
          "renewable": false,
          "lease_id": "",
          "lease_duration": 0,
          "auth": null,
          "data": { "error": "a TOTP code is required for this account" }
        }
      }
    }
  ],
  "expect": {
    "error": {
      "code": "BV-AUTH-007",
      "statusCode": 200,
      "retryable": false,
      "serverMessage": "a TOTP code is required for this account",
      "hintContains": ["totpCode"]
    },
    "clientState": { "Auth.CurrentToken": "$absent" }
  }
}
