{
  "id": "auth.appid.gated-403",
  "title": "A gated AppID login (403) maps to PermissionDenied and the hint names the namespace setting",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": ["AUT-041", "ERR-040"],
  "level": "core",
  "sections": ["05"],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": null,
    "namespace": "",
    "apiPrefix": "v1",
    "settings": { "RateGate": { "RatePerSecond": 0 }, "RetryPolicy": { "MaxAttempts": 1 } }
  },
  "operation": {
    "name": "Auth.AppId.Login",
    "args": {
      "roleId": "11111111-1111-1111-1111-111111111111",
      "secretId": "22222222-2222-2222-2222-222222222222",
      "mount": "approle"
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/auth/approle/login",
        "absentHeaders": ["X-BastionVault-Token", "X-BastionVault-Namespace"],
        "body": {
          "role_id": "11111111-1111-1111-1111-111111111111",
          "secret_id": "22222222-2222-2222-2222-222222222222"
        }
      },
      "respond": { "status": 403, "body": { "error": "Permission denied." } }
    }
  ],
  "expect": {
    "error": {
      "code": "BV-AUTHZ-001",
      "statusCode": 403,
      "retryable": false,
      "hintContains": ["No namespace is set", "Namespace"]
    },
    "clientState": { "Auth.CurrentToken": "$absent" }
  }
}
