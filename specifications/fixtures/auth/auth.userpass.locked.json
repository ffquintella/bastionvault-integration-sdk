{
  "id": "auth.userpass.locked",
  "title": "Locked account exposes retry_after_secs",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": [
    "AUT-011",
    "AUT-032"
  ],
  "level": "core",
  "sections": [
    "05"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": null,
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Auth.Userpass.Login",
    "args": {
      "username": "alice",
      "password": "password-fixture",
      "mount": "userpass"
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/auth/userpass/login/alice"
      },
      "respond": {
        "status": 200,
        "body": {
          "renewable": false,
          "lease_id": "",
          "lease_duration": 0,
          "auth": null,
          "data": {
            "error": "account temporarily locked; try again in 842 seconds"
          }
        }
      }
    }
  ],
  "expect": {
    "error": {
      "code": "BV-AUTH-006",
      "statusCode": 200,
      "retryable": false,
      "detailsKeys": [
