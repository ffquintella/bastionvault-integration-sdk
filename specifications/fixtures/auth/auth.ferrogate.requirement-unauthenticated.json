          "lease_id": "",
          "lease_duration": 0,
          "auth": null,
          "data": {
            "require_machine_identity": true,
            "expected_audience": "bastionvault",
            "trust_domain": "spiffe://example.internal",
            "mia_environment": "prod"
          }
        }
      }
    }
  ],
  "expect": {
    "result": {
      "RequireMachineIdentity": true,
      "ExpectedAudience": "bastionvault",
      "TrustDomain": "spiffe://example.internal",
      "MiaEnvironment": "prod"
    }
  }
