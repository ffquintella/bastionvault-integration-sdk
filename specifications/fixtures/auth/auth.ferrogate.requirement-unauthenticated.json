  "requirements": [
    "AUT-051",
    "CFG-020"
  ],
  "level": "standard",
  "sections": [
    "05"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": null,
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Auth.Ferrogate.Requirement",
    "args": {
