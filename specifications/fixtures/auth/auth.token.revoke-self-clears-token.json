{
  "id": "auth.token.revoke-self-clears-token",
  "title": "RevokeSelf posts to auth/token/revoke-self and clears the local token",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": [
    "CFG-070",
    "AUT-083"
  ],
  "level": "core",
  "sections": [
    "05"
  ],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": "s.FAKEtoken0000000000000000",
    "namespace": "",
    "apiPrefix": "v1",
    "settings": {
      "RateGate": {
        "RatePerSecond": 0
      },
      "RetryPolicy": {
        "MaxAttempts": 1
      }
    }
  },
  "operation": {
    "name": "Auth.Token.RevokeSelf"
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/auth/token/revoke-self",
        "headers": {
          "X-BastionVault-Token": "s.FAKEtoken0000000000000000",
          "Accept": "application/json"
        }
      },
      "respond": {
        "status": 204
      }
    }
  ],
  "expect": {
    "clientState": {
      "Auth.CurrentToken": "$absent"
    }
  }
}
