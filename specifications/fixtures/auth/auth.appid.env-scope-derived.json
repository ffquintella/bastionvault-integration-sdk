{
  "id": "auth.appid.env-scope-derived",
  "title": "An AppID login whose metadata carries no approle_env_* keys derives an unscoped EnvironmentScope",
  "capturedFrom": "BastionVault 0.42.x (derived from crates/bv-server and crates/bv-client behaviour)",
  "requirements": ["AUT-044"],
  "level": "core",
  "sections": ["05"],
  "client": {
    "address": "https://vault.example.com:8200",
    "token": null,
    "namespace": "",
    "apiPrefix": "v1",
    "settings": { "RateGate": { "RatePerSecond": 0 }, "RetryPolicy": { "MaxAttempts": 1 } }
  },
  "operation": {
    "name": "Auth.AppId.Login",
    "args": {
      "roleId": "11111111-1111-1111-1111-111111111111",
      "secretId": "22222222-2222-2222-2222-222222222222",
      "mount": "approle"
    }
  },
  "exchanges": [
    {
      "expectRequest": {
        "method": "POST",
        "url": "https://vault.example.com:8200/v1/auth/approle/login",
        "absentHeaders": ["X-BastionVault-Token"],
        "body": {
          "role_id": "11111111-1111-1111-1111-111111111111",
          "secret_id": "22222222-2222-2222-2222-222222222222"
        }
      },
      "respond": {
        "status": 200,
        "body": {
          "renewable": false,
          "lease_id": "",
          "lease_duration": 0,
          "auth": {
            "client_token": "s.FAKEappnoenv0000000000000000",
            "policies": ["default"],
            "metadata": { "role_name": "svc", "mount_path": "approle/" },
            "lease_duration": 1200,
            "renewable": true
          },
          "data": {}
        }
      }
    }
  ],
  "expect": {
    "result": {
      "ClientToken": "$redacted",
      "EnvironmentScope": { "Scoped": false, "SecretGlobs": [], "MachineGlobs": [] }
    },
    "clientState": { "Auth.CurrentToken": "$any" }
  }
}
